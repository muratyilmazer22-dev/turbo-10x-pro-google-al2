# 🤖 GOOGLE AI STUDIO API KEY
# https://ai.google.dev/ adresinden al
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# 🔥 FIREBASE (İsteğe bağlı - Vercel sync için)
VITE_FIREBASE_API_KEY=your-firebase-key
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# 📱 TELEFON UYGULAMASI AYARLARI
VITE_PHONE_MODE=true
VITE_USE_GEMINI_DIRECTLY=true
VITE_OFFLINE_FIRST=true

# 💾 VERİ SIKLADI
VITE_AUTO_BACKUP_INTERVAL=3600000
VITE_SYNC_TO_VERCEL=true
